rules_version = '2';
// Suggested Firestore rules: paste into Firebase Console > Firestore > Rules.
// Admin = users/{uid}.role == "admin". Set that manually in the console.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Users can read/create their own profile, but cannot make themselves admin
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role in ["student", "teacher"];
      allow update, delete: if isAdmin();
    }

    // Rooms: login page shows the room count, so reads are public
    match /rooms/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /routine/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /bookings/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.booked_by == request.auth.token.email;
      // Owners may only cancel their own booking; admins can do anything
      allow update: if isAdmin() || (isSignedIn() && resource.data.booked_by == request.auth.token.email);
      allow delete: if isAdmin();
    }
  }
}
